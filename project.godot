; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Veyr - A Morrowind-style Walk"
config/description="First-person exploration of an original island town in the visual style of early-2000s Morrowind."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"compress/mode": 2,
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.42, 0.45, 0.48, 1)

[shader_globals]

fog_color={
"type": "color",
"value": Color(0.62, 0.66, 0.7, 1)
}
fog_far={
"type": "float",
"value": 260.0
}
wind_strength={
"type": "float",
"value": 0.3
}
night_factor={
"type": "float",
"value": 0.0
}
water_level={
"type": "float",
"value": 0.0
}
sun_dir={
"type": "vec3",
"value": Vector3(0.3, 0.8, 0.4)
}
wetness={
"type": "float",
"value": 0.0
}
